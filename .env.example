# Copy to .env and fill in.

# Preferred: Anthropic direct
ANTHROPIC_API_KEY=

# Alternative: Azure OpenAI.
# If these are set, llm.py routes narration + chat through Azure OpenAI instead.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Stream source (any youtube live URL, RTSP, HLS .m3u8, or local mp4 path).
# Default: Times Square 24/7 live (busy ped + vehicle mix).
# FLEET_STREAM_SOURCE=https://www.youtube.com/watch?v=rnXIjl_Rzy4

# Sampling rate. 2 fps is a sensible default for yolov8n on a laptop CPU.
# FLEET_TARGET_FPS=2.0

# Slack alerts (optional). Uses files.upload_v2 so the screenshot is a real
# upload — no need to expose localhost publicly. Scopes: files:write, chat:write.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=C0123456789
# SLACK_MIN_RISK=high       # high | medium | low  (default: high)

# Edge → Cloud delivery (optional). Both must be set to enable.
# FLEET_CLOUD_ENDPOINT=https://cloud.example.com/api/ingest
# FLEET_CLOUD_HMAC_SECRET=your-shared-secret
# FLEET_EDGE_PUBLIC_URL=http://localhost:8000
# FLEET_EDGE_NODE_ID=edge_node_01

# Fleet identity (multi-vehicle).
# FLEET_VEHICLE_ID=vehicle_01
# FLEET_ID=fleet_demo
# FLEET_DRIVER_ID=driver_01

# Privacy / compliance.
# FLEET_PLATE_SALT=your-per-deployment-salt
# FLEET_DSAR_TOKEN=your-dsar-access-token
# FLEET_AUDIT_LOG=1          # 0 to disable audit logging

# Data retention (days). Enforced by background sweep.
# RETENTION_THUMBNAILS_DAYS=30
# RETENTION_FEEDBACK_DAYS=90
# RETENTION_AL_PENDING_DAYS=60
# RETENTION_OUTBOUND_DAYS=7
# RETENTION_INTERVAL_SEC=3600

# Digest schedulers.
# DIGEST_INTERVAL_SEC=3600   # medium-risk digest interval
# DAILY_INTERVAL_SEC=86400   # low-risk daily summary interval
