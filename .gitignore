.venv/
__pycache__/
*.pyc
.DS_Store

# Node / frontend dependencies (reinstalled via `npm install`)
node_modules/

# Secrets — never commit
.env
.env.*
!.env.example

# YOLO weights (downloaded on first run)
*.pt

# Packaging artifacts
*.egg-info/
dist/
build/

# Node / frontend dependencies and build artifacts
node_modules/
frontend/dist/
*.tsbuildinfo
.vite/
frontend/data/

# Runtime data (generated at runtime, never committed)
data/events.json
data/summary.json
data/eval.json
data/thumbnails/
data/feedback.jsonl
data/outbound_queue.jsonl
data/audit.jsonl
data/watchdog.jsonl
data/active_learning/pending/
data/test_suite/results.json
# Event clip extracts (±3s around each event) — generated at runtime for
# the EventDialog video player; can be large and not worth versioning.
data/clips/
# Stray runtime output if the frontend is started from its own CWD
frontend/data/
.test-report.json

# SQLite databases + WAL/SHM sidecars (covers cloud.db, settings.db, etc.)
data/*.db
data/*.db-shm
data/*.db-wal

# Input video (too large for git)
data/*.mp4
data/*.mov
data/*.MOV
resourses/

# Logs
*.log
logs/

# Process management
*.pid

# Test / coverage
.pytest_cache/
htmlcov/
.coverage
coverage/

# Python tool caches
.mypy_cache/
.ruff_cache/
.pyright/

# `make start` / `make stop` runtime artifacts
.road_safety.pid
.road_safety.log

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code — personal overrides only; commit shared config (.claude/settings.json, rules/, skills/, hooks/)
.claude/settings.local.json
CLAUDE.local.md
